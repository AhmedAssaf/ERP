# W-19: the pilot's edge (Caddy 2.10). Values in {$...} come from infra/pilot/.env through docker-compose.yml.
#
# Certificates (Let's Encrypt, ZeroSSL as fallback): the platform host and Keycloak's host are obtained at start. Tenant
# hosts use on-demand TLS: at the first handshake for a name Caddy holds no certificate for, it asks the web host
# (GET /internal/tls-ask?domain=<name> on its internal listener web:8081, which no site block below proxies to and
# Compose publishes nowhere) and obtains a certificate only on a 200: the name is one label under TENANT_BASE_DOMAIN and a
# tenant owns it (tenancy.tenant_hosts). A new tenant therefore needs DNS and provision-tenant.sh, never a Caddy redeploy.
# The tenant site is the catch-all `https://`, not `*.{$TENANT_BASE_DOMAIN}`: an on-demand wildcard site also covers the
# platform and auth hosts, whose certificates Caddy 2.10 then no longer obtains at start (seen 2026-10-03); the ask
# endpoint enforces the base domain instead.
#
# Forwarded headers (W-24): Caddy trusts no incoming X-Forwarded-* (no trusted_proxies), so it sends the client address it
# sees as X-Forwarded-For, the scheme as X-Forwarded-Proto, and the Host header unchanged. The web host takes the first
# two only from Caddy's pinned address (ForwardedHeaders:KnownProxies, CADDY_EDGE_IP) and never X-Forwarded-Host: the
# tenant always comes from Host.
{
	email {$ACME_EMAIL}
	# Required by Caddy for on-demand TLS; any answer but 200 (404, 429, an error, no answer) refuses the name.
	on_demand_tls {
		ask http://web:8081/internal/tls-ask
	}
	servers {
		# HTTP/3 off: the firewall opens TCP 80 and 443 only.
		protocols h1 h2
	}
}

(security_headers) {
	header {
		# defer: applied after the upstream's headers, so these values win.
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
}

(app_headers) {
	import security_headers
	header {
		defer
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# Enforced: no framing, no plugins, no base tag, forms post only to the app or Keycloak (sign-in and sign-out).
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self' https://{$AUTH_HOST}"
		# Report-only until a browser pass of every page on the pilot shows no violation (follow-up, docs/19 section 9).
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://{host}; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
	}
}

(app_site) {
	import app_headers
	encode zstd gzip
	# Blazor Server's WebSocket and the chunked uploads (4 MB per request, ADR-0001) pass through with Caddy's defaults.
	# Only the public listener: the ask listener (8081) is never a proxy target.
	reverse_proxy web:8080
}

# The platform console: one web host decides by Host (PlatformHostMiddleware, TenantMiddleware).
{$PLATFORM_HOST} {
	import app_site
}

# Every tenant host, certificate on demand (above). The more specific site blocks (platform, auth) win over this one.
https:// {
	tls {
		on_demand
	}
	import app_site
}

# Keycloak's public issuer. The Admin console and the master realm answer only from the operator's address; the web host
# reaches the Admin API on the internal network (KeycloakAdmin:BaseUrl), not through here.
{$AUTH_HOST} {
	import security_headers
	@operator_only {
		path /admin /admin/* /realms/master /realms/master/*
		not remote_ip {$ADMIN_ALLOW_CIDR}
	}
	respond @operator_only 404
	reverse_proxy keycloak:8080
}
