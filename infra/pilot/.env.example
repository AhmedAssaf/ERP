# W-19 pilot settings. Copy to infra/pilot/.env on the VM (git-ignored), owned by root with mode 600, and fill it:
#   sudo infra/pilot/generate-secrets.sh     # copies this file if .env is missing and fills every EMPTY secret below
# then set the non-secret values by hand (hosts, emails, SMTP and OCI details). Keep a copy of the finished file in the
# password manager: restore.sh needs it on a new VM, and nothing else holds these values (N-10).
# Format: KEY=value, no quotes, no spaces around '=', no ${...}. Passwords are hex (no ';' or quotes), so they are safe
# inside connection strings. Never paste a value into a ticket, chat or commit.

# ---------------------------------------------------------------- hosts and TLS (docs/19 step 2)
# The platform console (Platform:Host) and Keycloak's public issuer. DNS A records point both at the VM's public IP.
PLATFORM_HOST=platform.example.sa
AUTH_HOST=auth.example.sa
# Every tenant host Caddy should hold a certificate for, comma-separated (static list until the F-03 ask endpoint exists).
TENANT_HOSTS=acme.example.sa
# Where a staff invitation link returns; {slug} is the tenant slug, so tenant hosts are <slug>.<domain> on the pilot.
KEYCLOAK_TENANT_URL=https://{slug}.example.sa/
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=ops@example.sa
# The address you administer from (CIDR). Keycloak's admin console and master realm answer only from here.
ADMIN_ALLOW_CIDR=203.0.113.7/32
# Optional: change only if these collide with the VCN's addresses.
# EDGE_SUBNET=172.30.10.0/24
# CADDY_EDGE_IP=172.30.10.2
# WEB_EDGE_IP=172.30.10.3
# BACKEND_SUBNET=172.30.20.0/24
# EGRESS_SUBNET=172.30.30.0/24
# TUNNEL_SUBNET=172.30.40.0/24

# ---------------------------------------------------------------- images (build-images.sh, deploy.sh)
IMAGE_PREFIX=waslabid

# ---------------------------------------------------------------- PostgreSQL
# The owner and superuser inside the container (the migrator's ConnectionStrings:Owner). Never used by a host.
POSTGRES_USER=erp
# openssl rand -hex 32 (generate-secrets.sh fills every password below the same way unless noted)
POSTGRES_PASSWORD=
# erp_app: the web host (row-level security applies; never a superuser). bootstrap.sql sets it as a SCRAM verifier.
ERP_APP_DB_PASSWORD=
# erp_key_ring (W-24): the Data Protection key ring's own role; the migrator gives it its login.
ERP_KEY_RING_DB_PASSWORD=
# erp_worker (W-36): the worker's own role; the migrator gives it its login.
ERP_WORKER_DB_PASSWORD=
# keycloak: Keycloak's own role and database (never the superuser on the pilot).
KEYCLOAK_DB_PASSWORD=

# ---------------------------------------------------------------- Redis (W-34: required by the web host; the worker's F-60 check)
REDIS_PASSWORD=

# ---------------------------------------------------------------- MinIO (object storage on the VM's disk)
MINIO_ROOT_USER=waslabid-root
MINIO_ROOT_PASSWORD=
STORAGE_BUCKET=waslabid-pilot
# The hosts' user, limited to STORAGE_BUCKET (ObjectStorage:AccessKey/SecretKey).
MINIO_APP_ACCESS_KEY=waslabid-app
MINIO_APP_SECRET_KEY=
# List-only user of the worker's health check (Health:MinIo:*).
MINIO_HEALTH_PROBE_PASSWORD=
# Read-only user of backup.sh.
MINIO_BACKUP_PASSWORD=

# ---------------------------------------------------------------- Keycloak
# Temporary bootstrap admin of the master realm. Replace with a named admin on day one (docs/19 step 7) and keep this
# pair only until then.
KEYCLOAK_ADMIN=bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=
# Secret of the master realm's client waslabid-ops (service account; roles on waslabid-realm: manage-users, view-users,
# query-users, manage-clients, manage-realm), created on day one (docs/19 step 7); provision-tenant.sh uses it. Empty
# until then.
KEYCLOAK_OPS_CLIENT_SECRET=
# Client secrets substituted into keycloak/import/*.json at the first import (Oidc:ClientSecret, PlatformOidc:ClientSecret,
# KeycloakAdmin:ClientSecret).
WASLABID_WEB_CLIENT_SECRET=
WASLABID_PLATFORM_CLIENT_SECRET=
WASLABID_ADMIN_API_SECRET=
# The first platform admin (realm waslabid-platform). The initial password is temporary: Keycloak asks for a new one and
# an authenticator app at the first sign-in. At least 12 characters (the realm's password policy).
PLATFORM_ADMIN_USERNAME=ahmed
PLATFORM_ADMIN_EMAIL=ops@example.sa
PLATFORM_ADMIN_INITIAL_PASSWORD=

# ---------------------------------------------------------------- application secrets
# Duplicate-CR audit key (V-6): base64 of 32 bytes, `openssl rand -base64 32`. Keep it once set.
VENDORS_CR_AUDIT_KEY=
# Job signing key (W-42), both hosts: base64 of 32 bytes, `openssl rand -base64 32`.
WASLABID_JOB_SIGNING_KEY=
# Password of infra/pilot/secrets/key-ring.pfx (W-24); generate-secrets.sh also creates the certificate.
KEY_RING_CERT_PASSWORD=
# Who receives F-60 alerts and the watchdog's emails.
ALERT_RECIPIENT=ops@example.sa
# Optional (W-33): only with a Wathq subscription; leave both empty otherwise.
WATHQ_BASE_URL=
WATHQ_API_KEY=

# ---------------------------------------------------------------- email (docs/19 step 4)
# Sender of every platform and Keycloak email; its domain must be an approved sender in OCI Email Delivery.
SMTP_FROM=no-reply@example.sa
# OCI Email Delivery's SMTP endpoint for Jeddah (confirm in the console: Email Delivery, Configuration).
SMTP_RELAY_HOST=smtp.email.me-jeddah-1.oci.oraclecloud.com
SMTP_RELAY_PORT=587
# SMTP credentials generated for an OCI user (Identity, Users, SMTP credentials).
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
# Domains the relay accepts as senders (the SMTP_FROM domain).
SMTP_ALLOWED_SENDER_DOMAINS=example.sa
SMTP_HELO_NAME=platform.example.sa

# ---------------------------------------------------------------- telemetry (W-10, ADR-0014)
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
# The named platform-staff user who signs in to Kibana through the SSH tunnel (role viewer, O-18).
KIBANA_STAFF_USER=ahmed
KIBANA_STAFF_PASSWORD=
ELASTIC_MONITOR_PASSWORD=
ELASTIC_COLLECTOR_PASSWORD=
KIBANA_ENCRYPTION_KEY=
# Retention on the pilot (spec O-12): logs 30 days, traces 7, metrics 30.
TELEMETRY_LOGS_RETENTION=30d
TELEMETRY_TRACES_RETENTION=7d
TELEMETRY_METRICS_RETENTION=30d

# ---------------------------------------------------------------- backups to OCI Object Storage, Jeddah (docs/19 step 4)
# https://<object storage namespace>.compat.objectstorage.me-jeddah-1.oraclecloud.com (rclone.sh refuses other regions).
OCI_S3_ENDPOINT=https://NAMESPACE.compat.objectstorage.me-jeddah-1.oraclecloud.com
OCI_REGION=me-jeddah-1
OCI_BACKUP_BUCKET=waslabid-pilot-backups
# A Customer Secret Key of an OCI user limited to that bucket.
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=
# rclone crypt keys: everything is encrypted on the VM before upload. Losing these makes every backup unreadable.
BACKUP_CRYPT_PASSWORD=
BACKUP_CRYPT_SALT=
BACKUP_DIR=/var/backups/waslabid
BACKUP_RETENTION_DAYS=35
