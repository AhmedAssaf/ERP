{
  "realm": "waslabid-platform",
  "displayName": "WaslaBid platform",
  "enabled": true,
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": ["ar", "en"],
  "defaultLocale": "en",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "browserFlow": "platform browser",
  "attributes": {
    "acr.loa.map": "{\"1\":1,\"2\":2}"
  },
  "roles": {
    "realm": [
      { "name": "platform-admin", "description": "Operates the WaslaBid platform console (F-51, F-54, F-60)" }
    ]
  },
  "authenticationFlows": [
    {
      "alias": "platform browser",
      "description": "Step-up browser flow: password is level 1, OTP is level 2 (D-2)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10, "authenticatorFlow": false, "userSetupAllowed": false },
        { "flowAlias": "platform browser forms", "requirement": "ALTERNATIVE", "priority": 20, "authenticatorFlow": true, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "platform browser forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "flowAlias": "platform level 1 password", "requirement": "CONDITIONAL", "priority": 10, "authenticatorFlow": true, "userSetupAllowed": false },
        { "flowAlias": "platform level 2 otp", "requirement": "CONDITIONAL", "priority": 20, "authenticatorFlow": true, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "platform level 1 password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-level-of-authentication", "authenticatorConfig": "platform level 1", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false, "userSetupAllowed": false },
        { "authenticator": "auth-username-password-form", "requirement": "REQUIRED", "priority": 20, "authenticatorFlow": false, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "platform level 2 otp",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-level-of-authentication", "authenticatorConfig": "platform level 2", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "requirement": "REQUIRED", "priority": 20, "authenticatorFlow": false, "userSetupAllowed": false }
      ]
    }
  ],
  "authenticatorConfig": [
    { "alias": "platform level 1", "config": { "loa-condition-level": "1", "loa-max-age": "36000" } },
    { "alias": "platform level 2", "config": { "loa-condition-level": "2", "loa-max-age": "0" } }
  ],
  "clients": [
    {
      "clientId": "waslabid-platform-web",
      "name": "WaslaBid platform console",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${WASLABID_PLATFORM_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://platform.localhost:8443/signin-platform",
        "https://platform.localhost/signin-platform"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "minimum.acr.value": "2",
        "post.logout.redirect.uris": "https://platform.localhost:8443/*##https://platform.localhost/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles in id token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["basic", "profile", "email", "roles", "web-origins", "acr"]
    }
  ],
  "users": [
    {
      "username": "platform.admin",
      "enabled": true,
      "email": "platform.admin@waslabid.test",
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "attributes": { "locale": ["en"] },
      "realmRoles": ["platform-admin"],
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [{ "type": "password", "value": "${WASLABID_DEV_USER_PASSWORD}", "temporary": false }]
    }
  ]
}
