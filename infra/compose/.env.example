# Copy to .env (git-ignored). Development values only; production secrets live in the cloud KMS, never in files.
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_PORT=5432

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

REDIS_PORT=6379

MINIO_ROOT_USER=erp
MINIO_ROOT_PASSWORD=erp_dev_password
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003
STORAGE_BUCKET=erp-dev
# Least-privilege health-probe MinIO user (list-only): generate with `openssl rand -hex 16`.
MINIO_HEALTH_PROBE_PASSWORD=

CLAMAV_PORT=3310

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Caddy edge ports. Defaults 80 and 443; on Windows machines where 443 is reserved (Hyper-V), use 8081 and 8443.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Port the .NET app listens on when run from the host; Caddy forwards tenant hostnames here.
APP_PORT=5273

# Keycloak realm import placeholders (keycloak/import/waslabid-realm.json and waslabid-platform-realm.json).
# Generate your own values (README step 1), e.g. `openssl rand -hex 32` for each client secret.
# WASLABID_DEV_USER_PASSWORD must meet the platform realm's password policy (at least 12 characters, not a
# username), or Keycloak refuses the import and does not start.
WASLABID_WEB_CLIENT_SECRET=
WASLABID_PLATFORM_CLIENT_SECRET=
WASLABID_DEV_USER_PASSWORD=
# Secret of the waslabid-admin-api service account (staff invitations through the Keycloak Admin API, F-06); the web
# host reads it as the user secret KeycloakAdmin:ClientSecret (docs/07 section 4). Generate with `openssl rand -hex 32`.
WASLABID_ADMIN_API_SECRET=
# Key of the duplicate-CR audit (V-6): the web host reads it as the user secret Vendors:CrAuditKey (docs/07 section 4)
# and does not start without it. Base64 of at least 32 bytes: generate with `openssl rand -base64 32`. Keep it once set:
# a new key makes earlier audit entries unmatchable with later ones.
VENDORS_CR_AUDIT_KEY=
# Password of erp_key_ring, the only database role with rights on the Data Protection key ring (W-24). The migrator
# gives the role its login from the user secret ConnectionStrings:KeyRing built with it, and the web host's key-ring pool
# connects with the same secret (docs/07 section 4). Generate with `openssl rand -hex 32`.
ERP_KEY_RING_DB_PASSWORD=
