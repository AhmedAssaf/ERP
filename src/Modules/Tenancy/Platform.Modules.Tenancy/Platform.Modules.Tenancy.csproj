<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\..\Platform.Shared\Platform.Shared.csproj" />
    <ProjectReference Include="..\Platform.Modules.Tenancy.Contracts\Platform.Modules.Tenancy.Contracts.csproj" />
    <ProjectReference Include="..\..\Audit\Platform.Modules.Audit.Contracts\Platform.Modules.Audit.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Logo re-encoding (F-02, D-10). The Linux native build without fontconfig is for the containers; Windows and macOS
         native assets come with SkiaSharp itself. -->
    <!-- W-38: the logo cleanup job (the same Hangfire.Core the Vendors module uses for its jobs). -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="Migrations.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Platform.UnitTests" />
    <InternalsVisibleTo Include="Platform.IntegrationTests" />
  </ItemGroup>
</Project>
