@*
    A file upload over chunked HTTP (docs/08 section 6, ADR-0001, W-06). The file never crosses the Blazor circuit: the
    script (wwwroot/js/fileUpload.js) reads 1 MB slices with File.slice, hashes each with SHA-256 and sends it with fetch
    to EndpointBaseUrl (start, chunks, complete) with the antiforgery header; only the file's name, size and type, the
    progress and the outcome come back through the circuit. A chunk that fails is retried three times with a growing
    pause; after that the upload stops and Retry resumes from that chunk. Type and size are checked here before the
    script sends anything, and the server checks them again. Generic on purpose: it knows the upload protocol, not what
    is uploaded; the page maps the server's error codes to reasons (RejectionText).
*@
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AntiforgeryStateProvider Antiforgery
@inject IStringLocalizer<SharedResource> T
@inject ILogger<FileUpload> Logger

<div data-file-upload class="grid gap-4">
    <div class="grid gap-1.5">
        <FieldLabel For="@FileId" Label="@Label" Required="true" />
        <p id="@HelpId" class="text-small text-ink-muted">@T["FileUpload.Help", TypeNames(), MaxMegabytes]</p>
        <input @ref="_input" id="@FileId" type="file" accept="@Accept" disabled="@Busy" aria-describedby="@HelpId"
               @onchange="OnFileChosenAsync"
               class="w-full text-body text-ink file:me-3 file:min-h-11 file:cursor-pointer file:rounded-control file:border file:border-ink-muted file:bg-surface file:px-4 file:py-2 file:text-body file:font-medium file:text-ink disabled:cursor-not-allowed" />
    </div>
    @if (ExpiryRequired)
    {
        <div class="grid gap-1.5">
            <FieldLabel For="@ExpiryId" Label="@T["FileUpload.Expiry"]" Required="true" />
            <input id="@ExpiryId" type="date" value="@_expiry" required disabled="@Busy"
                   aria-invalid="@(_expiryError is null ? null : "true")" aria-describedby="@(_expiryError is null ? null : ExpiryErrorId)"
                   @onchange="OnExpiryChanged"
                   class="min-h-11 w-full max-w-xs rounded-control border border-ink-muted bg-surface px-3 py-2 text-body text-ink disabled:cursor-not-allowed disabled:bg-canvas aria-[invalid=true]:border-2 aria-[invalid=true]:border-danger" />
            <FieldHints Error="@_expiryError" HelpId="@($"{ExpiryId}-help")" ErrorId="@ExpiryErrorId" />
        </div>
    }
    <div class="flex flex-wrap items-center gap-3">
        <Button Variant="ButtonVariant.Primary" Disabled="@(!CanStart)" Loading="Busy" OnClick="StartAsync" data-file-upload-start>@T["FileUpload.Start"]</Button>
        @if (_state == FileUploadState.Uploading)
        {
            <Button Variant="ButtonVariant.Secondary" OnClick="CancelAsync" data-file-upload-cancel>@T["FileUpload.Cancel"]</Button>
        }
    </div>
    <FileUploadStatus State="_state" Percent="_percent" Reason="@_reason" OnRetry="RetryAsync" />
</div>

@code {
    /// <summary>The script, served by this library as a static web asset.</summary>
    public const string ModulePath = "./_content/Platform.UI/js/fileUpload.js";

    /// <summary>The header the server's antiforgery check reads (ASP.NET Core's default).</summary>
    public const string TokenHeader = "RequestVerificationToken";

    private const long Megabyte = 1024 * 1024;

    private readonly string _id = $"upload-{Guid.NewGuid():N}";
    private ElementReference _input;
    private IJSObjectReference? _module;
    private DotNetObjectReference<FileUpload>? _callbacks;
    private FileUploadSelection? _selection;
    private FileUploadState _state;
    private int _percent;
    private int _resumeFrom;
    private string? _reason;
    private string? _expiry;
    private string? _expiryError;

    /// <summary>What is uploaded, as the label of the file chooser ("Commercial registration certificate").</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>Sent to the upload API as <c>documentType</c>.</summary>
    [Parameter, EditorRequired] public string DocumentType { get; set; } = string.Empty;

    /// <summary>The content types accepted, such as application/pdf; checked before anything is sent.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> AcceptedTypes { get; set; } = [];

    /// <summary>The largest file accepted, in bytes; checked before anything is sent.</summary>
    [Parameter, EditorRequired] public long MaxBytes { get; set; }

    /// <summary>Asks for the document's expiry date, sent with the completion as <c>expiresOn</c>.</summary>
    [Parameter] public bool ExpiryRequired { get; set; }

    /// <summary>The upload API: POST here starts, PUT {id}/chunks/{n} sends a chunk, POST {id}/complete completes.</summary>
    [Parameter, EditorRequired] public string EndpointBaseUrl { get; set; } = string.Empty;

    /// <summary>After the server stored the file: clean (listed) or still waiting for its virus scan.</summary>
    [Parameter] public EventCallback<FileUploadCompleted> OnCompleted { get; set; }

    /// <summary>The reader's reason for a server error code; null (or no function) shows a general reason.</summary>
    [Parameter] public Func<string, string?>? RejectionText { get; set; }

    private string FileId => $"{_id}-file";

    private string HelpId => $"{_id}-help";

    private string ExpiryId => $"{_id}-expiry";

    private string ExpiryErrorId => $"{ExpiryId}-error";

    private string Accept => string.Join(',', AcceptedTypes);

    private long MaxMegabytes => Math.Max(1, MaxBytes / Megabyte);

    private bool Busy => _state is FileUploadState.Uploading or FileUploadState.Scanning;

    private bool CanStart => _selection is not null && !Busy && _state != FileUploadState.Rejected;

    /// <summary>Called by the script after each chunk arrived.</summary>
    [JSInvokable]
    public Task ReportProgressAsync(long sent, long total) => InvokeAsync(() =>
    {
        _percent = total <= 0 ? 0 : (int)Math.Clamp(sent * 100 / total, 0, 100);
        StateHasChanged();
    });

    /// <summary>Called by the script when every chunk arrived and the completion (assembly and virus scan) starts.</summary>
    [JSInvokable]
    public Task ReportScanningAsync() => InvokeAsync(() =>
    {
        _state = FileUploadState.Scanning;
        StateHasChanged();
    });

    private async Task OnFileChosenAsync(ChangeEventArgs e)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        _selection = await _module.InvokeAsync<FileUploadSelection?>("describe", _input);
        _state = FileUploadState.Idle;
        _reason = null;
        if (_selection is null)
        {
            return;
        }

        if (Refusal(_selection) is { } refusal)
        {
            _selection = null;
            Reject(refusal);
        }
    }

    private void OnExpiryChanged(ChangeEventArgs e)
    {
        _expiry = e.Value as string;
        if (!string.IsNullOrWhiteSpace(_expiry))
        {
            _expiryError = null;
        }
    }

    private async Task StartAsync()
    {
        if (!CanStart || _module is null)
        {
            return;
        }

        if (ExpiryRequired && string.IsNullOrWhiteSpace(_expiry))
        {
            _expiryError = T["FileUpload.ExpiryRequired"];
            return;
        }

        _callbacks ??= DotNetObjectReference.Create(this);
        _percent = 0;
        _state = FileUploadState.Uploading;
        var token = Antiforgery.GetAntiforgeryToken();
        var request = new FileUploadRequest(_id, EndpointBaseUrl, DocumentType, ExpiryRequired ? _expiry : null, token?.Value, TokenHeader);
        await HandleAsync(await _module.InvokeAsync<FileUploadOutcome>("upload", _input, request, _callbacks));
    }

    private async Task RetryAsync()
    {
        if (_module is null || _state != FileUploadState.Failed)
        {
            return;
        }

        _state = FileUploadState.Uploading;
        await HandleAsync(await _module.InvokeAsync<FileUploadOutcome>("resume", _id, _resumeFrom));
    }

    private async Task CancelAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("cancel", _id);
        }
    }

    private async Task HandleAsync(FileUploadOutcome outcome)
    {
        switch (outcome.Kind)
        {
            case FileUploadOutcome.Done or FileUploadOutcome.Pending when outcome.DocumentId is { } documentId:
                var pending = outcome.Kind == FileUploadOutcome.Pending;
                _state = pending ? FileUploadState.Pending : FileUploadState.Done;
                _selection = null;
                await OnCompleted.InvokeAsync(new FileUploadCompleted(documentId, pending));
                break;
            case FileUploadOutcome.Failed:
                _state = FileUploadState.Failed;
                _resumeFrom = outcome.ResumeFrom;
                break;
            case FileUploadOutcome.Cancelled:
                _state = FileUploadState.Idle;
                _selection = null;
                break;
            default:
                _selection = null;
                Reject(ServerReason(outcome.Code));
                break;
        }
    }

    private void Reject(string reason)
    {
        _state = FileUploadState.Rejected;
        _reason = reason;
    }

    private string? Refusal(FileUploadSelection file)
    {
        if (!AcceptedTypes.Contains(file.Type, StringComparer.OrdinalIgnoreCase))
        {
            return T["FileUpload.WrongType", TypeNames()];
        }

        if (file.Size <= 0)
        {
            return T["FileUpload.Empty"];
        }

        return file.Size > MaxBytes ? T["FileUpload.TooLarge", MaxMegabytes].Value : null;
    }

    private string ServerReason(string? code) => code switch
    {
        FileUploadOutcome.SignedOut => T["FileUpload.SignedOut"],
        not null when RejectionText?.Invoke(code) is { } text => text,
        _ => T["FileUpload.NotAccepted"],
    };

    /// <summary>"PDF, PNG or JPEG": the accepted types as people know them, in the reader's language.</summary>
    private string TypeNames()
    {
        var names = AcceptedTypes.Select(TypeName).Distinct(StringComparer.Ordinal).ToList();
        return names.Count switch
        {
            0 => string.Empty,
            1 => names[0],
            _ => $"{string.Join(T["FileUpload.ListSeparator"].Value, names.Take(names.Count - 1))} {T["FileUpload.Or"]} {names[^1]}",
        };
    }

    private static string TypeName(string contentType) => contentType.ToLowerInvariant() switch
    {
        "application/pdf" => "PDF",
        "image/png" => "PNG",
        "image/jpeg" => "JPEG",
        var other => other[(other.IndexOf('/', StringComparison.Ordinal) + 1)..].ToUpperInvariant(),
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("forget", _id);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException ex)
            {
                // The circuit is gone, and the page's script state with it: nothing is left to release.
                Logger.LogDebug(ex, "FileUpload {UploadKey} disposed after the circuit disconnected.", _id);
            }
        }

        _callbacks?.Dispose();
    }
}
