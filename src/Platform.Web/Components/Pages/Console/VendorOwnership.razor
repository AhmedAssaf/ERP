@*
    W-33: the platform's CR ownership check and the review of disputes. The method (Manual or Wathq) is a platform setting
    because vendor identity is global (ADR-0008) and the Wathq subscription is the platform's; whether Wathq is configured
    is shown, never its address or key (N-10). Disputes (ADR-0013 decision 1): a new one holds nothing for a verified
    company until an admin accepts it for review; each pending one can then be upheld, which moves the company to the
    claimant as its vendor admin, or rejected, both with a note and a confirmation, all audited in the platform audit. An
    uphold whose identity provider update failed stays listed with a retry. The policy is checked again at the moment of
    each action, since the circuit's claims date from when the page opened.
*@
@page "/platform/vendors"
@attribute [Authorize(Policy = PlatformAuthentication.PolicyName)]
@layout ConsoleLayout
@rendermode InteractiveServer
@using Platform.Modules.Identity.Contracts
@using Platform.Modules.Tenancy.Contracts
@using Platform.Modules.Vendors.Contracts
@inject ICrOwnershipAdministration Ownership
@inject ITenantCatalog Catalog
@inject IAuthorizationService Authorization
@inject ToastService Toasts
@inject ILogger<VendorOwnership> Logger
@inject IStringLocalizer<SharedResource> T

<PageTitle>@T["Console.Ownership.Title"]</PageTitle>

<h1 class="text-display">@T["Console.Ownership.Title"]</h1>

@if (_settings is null)
{
    <p class="text-ink-muted" role="status">@T["Console.Loading"]</p>
}
else
{
    <section aria-labelledby="method-heading" class="grid max-w-2xl gap-4 rounded-card border border-line bg-surface p-4"
             data-ownership-method="@Code(_settings.Method)">
        <h2 id="method-heading" class="text-heading">@T["Console.Ownership.Method.Heading"]</h2>
        <p class="text-body">@T["Console.Ownership.Method.Intro"]</p>
        <p>
            @if (_settings.WathqConfigured)
            {
                <StatusBadge Tone="StatusTone.Success" data-wathq-configured="true">@T["Console.Ownership.Wathq.Configured"]</StatusBadge>
            }
            else
            {
                <StatusBadge Tone="StatusTone.Warning" data-wathq-configured="false">@T["Console.Ownership.Wathq.NotConfigured"]</StatusBadge>
            }
        </p>
        @if (_choice == CrOwnershipMethod.Wathq && !_settings.WathqConfigured)
        {
            <p role="note" class="text-small text-warning" data-wathq-fallback>@T["Console.Ownership.Wathq.Fallback"]</p>
        }
        <Select Label="@T["Console.Ownership.Method.Label"]" Options="_methods" Value="@Code(_choice)" ValueChanged="ChooseMethod" data-method-select />
        <div>
            <Button Variant="ButtonVariant.Primary" Loading="_savingMethod" data-save-method OnClick="SaveMethodAsync">@T["Console.Ownership.Method.Save"]</Button>
        </div>
    </section>

    @if (_failures.Count > 0)
    {
        <section aria-labelledby="idp-heading" class="grid gap-3 rounded-card border border-danger bg-surface p-4" data-idp-failures>
            <h2 id="idp-heading" class="text-heading">@T["Console.Ownership.Idp.Heading"]</h2>
            <p class="max-w-prose text-body">@T["Console.Ownership.Idp.Intro"]</p>
            <ul class="grid gap-3">
                @foreach (var failure in _failures)
                {
                    <li data-idp-failure="@failure.DisputeId" class="flex flex-wrap items-center gap-3">
                        <span class="grid">
                            <span class="font-semibold">@Name(failure.CompanyNameAr, failure.CompanyNameEn)</span>
                            <span class="text-small text-ink-muted">@T["Console.Ownership.Idp.Line", failure.ClaimantName] <ConsoleTime At="failure.UpheldAt" /></span>
                            @if (failure.FailedSteps.Count > 0)
                            {
                                <span class="text-small" data-idp-failed-steps>@T["Console.Ownership.Idp.FailedSteps"] <bdi dir="ltr">@string.Join(", ", failure.FailedSteps)</bdi></span>
                            }
                        </span>
                        <Button Variant="ButtonVariant.Secondary" Loading="_retrying == failure.DisputeId" data-idp-retry="@failure.DisputeId"
                                OnClick="() => RetryAsync(failure)">@T["Console.Ownership.Idp.Retry"]</Button>
                    </li>
                }
            </ul>
        </section>
    }

    <section aria-labelledby="disputes-heading" class="grid gap-4">
        <h2 id="disputes-heading" class="text-heading">@T["Console.Ownership.Disputes.Heading"]</h2>
        <p class="max-w-prose text-body text-ink-muted">@T["Console.Ownership.Disputes.Intro"]</p>
        <DataTable Items="_disputes" Label="@T["Console.Ownership.Disputes.Heading"]">
            <ChildContent>
                <TemplateColumn TGridItem="CrDispute" Title="@T["Console.Ownership.Disputes.Company"]">
                    <span data-dispute="@context.Id" class="grid">
                        <span class="font-semibold">@Name(context.CompanyNameAr, context.CompanyNameEn)</span>
                        <span class="text-small text-ink-muted">@T["Console.Ownership.Disputes.Cr"] <bdi dir="ltr" class="tabular-nums">@context.CrNumber</bdi></span>
                    </span>
                </TemplateColumn>
                <TemplateColumn TGridItem="CrDispute" Title="@T["Console.Ownership.Disputes.State"]">
                    <span class="grid justify-items-start gap-1">
                        @if (context.Status == CrDisputeStatus.UnderReview)
                        {
                            <StatusBadge Tone="StatusTone.Warning" data-dispute-status="@($"{context.Id}:under_review")">@T["Console.Ownership.Status.UnderReview"]</StatusBadge>
                        }
                        else
                        {
                            <StatusBadge Tone="StatusTone.Info" data-dispute-status="@($"{context.Id}:open")">@T["Console.Ownership.Status.Open"]</StatusBadge>
                        }
                        @if (context.OverCap)
                        {
                            @* Never refused for the cap (the real owner might be the sixth): badged while five older ones of the company are pending. *@
                            <StatusBadge Tone="StatusTone.Neutral" data-over-cap="@($"{context.Id}:{context.CompanyPending}")">@T["Console.Ownership.OverCap", context.CompanyPending]</StatusBadge>
                        }
                    </span>
                </TemplateColumn>
                <TemplateColumn TGridItem="CrDispute" Title="@T["Console.Ownership.Disputes.Claimant"]">
                    <span class="grid">
                        <span>@context.ClaimantName <span class="text-small text-ink-muted">@T["Admin.Vendors.Ownership.SelfDeclared"]</span></span>
                        <bdi dir="ltr" class="text-small text-start">@context.ClaimantEmail</bdi>
                    </span>
                </TemplateColumn>
                <TemplateColumn TGridItem="CrDispute" Title="@T["Console.Ownership.Disputes.Statement"]">
                    <span class="block max-w-prose whitespace-pre-line text-small">@context.Statement</span>
                </TemplateColumn>
                <TemplateColumn TGridItem="CrDispute" Title="@T["Console.Ownership.Disputes.Raised"]">
                    <span class="grid">
                        <ConsoleTime At="context.RaisedAt" />
                        <span class="text-small text-ink-muted">@TenantName(context.RaisedOnTenant)</span>
                    </span>
                </TemplateColumn>
                <TemplateColumn TGridItem="CrDispute" Title="@T["Console.Ownership.Disputes.Current"]">
                    <span class="grid text-small" data-dispute-registrant="@context.Id">
                        @if (context.Registrant is { Name: null, Email: null } || context.Registrant is null)
                        {
                            <span class="text-ink-muted">@T["Admin.Vendors.Ownership.RegistrantUnknown"]</span>
                        }
                        else
                        {
                            @if (context.Registrant.Name is { } registrantName)
                            {
                                <span>@registrantName <span class="text-ink-muted">@T["Admin.Vendors.Ownership.SelfDeclared"]</span></span>
                            }
                            @if (context.Registrant.Email is { } registrantEmail)
                            {
                                <span>
                                    <bdi dir="ltr">@registrantEmail</bdi>
                                    <span class="text-ink-muted">@(context.Registrant.EmailVerified ? T["Admin.Vendors.Ownership.EmailVerified"] : T["Admin.Vendors.Ownership.EmailUnverified"])</span>
                                </span>
                            }
                        }
                        <span dir="ltr" class="text-start text-ink-muted">@(context.RegistrantUserId ?? "—")</span>
                        <span class="text-ink-muted">@(context.OwnershipVerifiedBy is { } by ? T[$"Console.Ownership.Verified.{by}"] : T["Console.Ownership.Verified.None"])</span>
                    </span>
                </TemplateColumn>
                <TemplateColumn TGridItem="CrDispute" Title="@T["Console.Jobs.Action"]">
                    <span class="flex flex-wrap gap-2">
                        @if (context.Status == CrDisputeStatus.Open)
                        {
                            <Button Variant="ButtonVariant.Secondary" data-accept="@context.Id" OnClick="() => Ask(context, DisputeAction.Accept)">@T["Console.Ownership.Accept"]</Button>
                        }
                        <Button Variant="ButtonVariant.Primary" data-uphold="@context.Id" OnClick="() => Ask(context, DisputeAction.Uphold)">@T["Console.Ownership.Uphold"]</Button>
                        <Button Variant="ButtonVariant.Danger" data-reject="@context.Id" OnClick="() => Ask(context, DisputeAction.Reject)">@T["Console.Ownership.Reject"]</Button>
                    </span>
                </TemplateColumn>
            </ChildContent>
            <EmptyContent>
                <EmptyState Title="@T["Console.Ownership.Disputes.EmptyTitle"]" HeadingLevel="3">@T["Console.Ownership.Disputes.EmptyBody"]</EmptyState>
            </EmptyContent>
        </DataTable>
    </section>
}

@if (_pending is { } pending)
{
    <Dialog @bind-Open="_dialogOpen" Busy="_busy" OnConfirm="ActAsync"
            ConfirmVariant="@(_action == DisputeAction.Reject ? ButtonVariant.Danger : ButtonVariant.Primary)"
            Title="@DialogTitle(pending)" ConfirmText="@DialogConfirm()">
        <p>@DialogBody()</p>
        @if (_action != DisputeAction.Accept)
        {
            <Textarea Label="@T["Console.Ownership.Note"]" Help="@T["Console.Ownership.NoteHelp"]" Required="true" Rows="3" @bind-Value="_note"
                      Error="@_noteError" data-resolution-note maxlength="1000" />
        }
        @if (_dialogError is not null)
        {
            <p role="alert" class="text-small text-danger">@_dialogError</p>
        }
    </Dialog>
}

<ToastRegion />

@code {
    private CrOwnershipSettings? _settings;
    private IReadOnlyList<CrDispute> _disputes = [];
    private IReadOnlyList<CrDisputeIdentityProviderFailure> _failures = [];
    private IReadOnlyDictionary<Guid, string> _tenants = new Dictionary<Guid, string>();
    private IReadOnlyList<SelectOption> _methods = [];
    private CrOwnershipMethod _choice;
    private bool _savingMethod;
    private Guid? _retrying;
    private CrDispute? _pending;
    private DisputeAction _action;
    private bool _dialogOpen;
    private bool _busy;
    private string? _note;
    private string? _noteError;
    private string? _dialogError;

    private enum DisputeAction
    {
        Accept,
        Uphold,
        Reject,
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _methods =
        [
            new SelectOption(Code(CrOwnershipMethod.Manual), T["Console.Ownership.Method.Manual"]),
            new SelectOption(Code(CrOwnershipMethod.Wathq), T["Console.Ownership.Method.Wathq"]),
        ];
        _tenants = (await Catalog.ListAsync()).ToDictionary(t => t.Id, t => t.PortalName);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _settings = await Ownership.GetSettingsAsync();
        _choice = _settings.Method;
        _disputes = await Ownership.ListOpenDisputesAsync();
        _failures = await Ownership.ListIdentityProviderFailuresAsync();
    }

    private void ChooseMethod(string value) =>
        _choice = value == Code(CrOwnershipMethod.Wathq) ? CrOwnershipMethod.Wathq : CrOwnershipMethod.Manual;

    private async Task SaveMethodAsync()
    {
        _savingMethod = true;
        try
        {
            if (await ActorAsync() is not { } actor)
            {
                Toasts.Show(T["Console.Jobs.NotAllowed"], ToastTone.Danger);
                return;
            }

            await Ownership.SetMethodAsync(_choice, actor);
            Toasts.Show(T["Console.Ownership.Method.Saved", T[$"Console.Ownership.Method.{_choice}"]], ToastTone.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ConsoleLog.OwnershipActionFailed(Logger, "method", ex.GetType().Name);
            Toasts.Show(T["Console.Ownership.Failed"], ToastTone.Danger);
        }
        finally
        {
            _savingMethod = false;
        }
    }

    private async Task RetryAsync(CrDisputeIdentityProviderFailure failure)
    {
        _retrying = failure.DisputeId;
        try
        {
            if (await ActorAsync() is not { } actor)
            {
                Toasts.Show(T["Console.Jobs.NotAllowed"], ToastTone.Danger);
                return;
            }

            switch (await Ownership.RetryIdentityProviderAsync(failure.DisputeId, actor))
            {
                case CrDisputeRetry.Updated:
                    Toasts.Show(T["Console.Ownership.Idp.Done", failure.ClaimantName], ToastTone.Success);
                    break;
                case CrDisputeRetry.Superseded:
                    Toasts.Show(T["Console.Ownership.Idp.Superseded", failure.ClaimantName], ToastTone.Info);
                    break;
                default:
                    Toasts.Show(T["Console.Ownership.Idp.StillFailing"], ToastTone.Danger);
                    break;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            ConsoleLog.OwnershipActionFailed(Logger, "idp-retry", ex.GetType().Name);
            Toasts.Show(T["Console.Ownership.Failed"], ToastTone.Danger);
        }
        finally
        {
            _retrying = null;
        }
    }

    private void Ask(CrDispute dispute, DisputeAction action)
    {
        _pending = dispute;
        _action = action;
        _note = null;
        _noteError = null;
        _dialogError = null;
        _dialogOpen = true;
    }

    private async Task ActAsync()
    {
        if (_pending is not { } pending)
        {
            return;
        }

        _busy = true;
        _noteError = null;
        _dialogError = null;
        try
        {
            if (await ActorAsync() is not { } actor)
            {
                _dialogError = T["Console.Jobs.NotAllowed"];
                return;
            }

            var name = Name(pending.CompanyNameAr, pending.CompanyNameEn);
            switch (_action)
            {
                case DisputeAction.Accept:
                    var accepted = await Ownership.AcceptForReviewAsync(pending.Id, actor);
                    if (!accepted.IsSuccess)
                    {
                        SetError(accepted.Error.Code);
                        return;
                    }

                    Toasts.Show(T["Console.Ownership.Accepted", name], ToastTone.Success);
                    break;
                case DisputeAction.Uphold:
                    var upheld = await Ownership.UpholdAsync(pending.Id, _note, actor);
                    if (!upheld.IsSuccess)
                    {
                        SetError(upheld.Error.Code);
                        return;
                    }

                    Toasts.Show(
                        !upheld.Value.IdentityProviderOutcomeRecorded
                            ? T["Console.Ownership.UpheldNotRecorded", name, pending.ClaimantName]
                            : upheld.Value.IdentityProviderUpdated
                                ? T["Console.Ownership.Upheld", name, pending.ClaimantName]
                                : T["Console.Ownership.UpheldKeycloakFailed", name, pending.ClaimantName],
                        upheld.Value.IdentityProviderUpdated && upheld.Value.IdentityProviderOutcomeRecorded ? ToastTone.Success : ToastTone.Danger);
                    break;
                default:
                    var rejected = await Ownership.RejectAsync(pending.Id, _note, actor);
                    if (!rejected.IsSuccess)
                    {
                        SetError(rejected.Error.Code);
                        return;
                    }

                    Toasts.Show(T["Console.Ownership.Rejected", pending.ClaimantName], ToastTone.Success);
                    break;
            }

            _dialogOpen = false;
            _pending = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ConsoleLog.OwnershipActionFailed(Logger, _action.ToString(), ex.GetType().Name);
            _dialogError = T["Console.Ownership.Failed"];
        }
        finally
        {
            _busy = false;
        }
    }

    private string DialogTitle(CrDispute pending) => _action switch
    {
        DisputeAction.Accept => T["Console.Ownership.AcceptTitle", Name(pending.CompanyNameAr, pending.CompanyNameEn)],
        DisputeAction.Uphold => T["Console.Ownership.UpholdTitle", Name(pending.CompanyNameAr, pending.CompanyNameEn), pending.ClaimantName],
        _ => T["Console.Ownership.RejectTitle", pending.ClaimantName],
    };

    private string DialogConfirm() => _action switch
    {
        DisputeAction.Accept => T["Console.Ownership.AcceptConfirm"],
        DisputeAction.Uphold => T["Console.Ownership.UpholdConfirm"],
        _ => T["Console.Ownership.RejectConfirm"],
    };

    private string DialogBody() => _action switch
    {
        DisputeAction.Accept => T["Console.Ownership.AcceptBody"],
        DisputeAction.Uphold => T["Console.Ownership.UpholdBody"],
        _ => T["Console.Ownership.RejectBody"],
    };

    private void SetError(string code)
    {
        if (code == CrDisputeErrors.NoteRequired)
        {
            _noteError = T["Console.Ownership.Error.Note"];
            return;
        }

        _dialogError = code switch
        {
            CrDisputeErrors.NotOpen => T["Console.Ownership.Error.NotOpen"],
            CrDisputeErrors.AlreadyVendor => T["Console.Ownership.Error.AlreadyVendor"],
            CrDisputeErrors.StaffAccount => T["Console.Ownership.Error.StaffAccount"],
            _ => T["Console.Ownership.Failed"],
        };
    }

    // The circuit's user was authorized when the page loaded; check again at the moment of the action.
    private async Task<string?> ActorAsync()
    {
        if (AuthenticationState is null)
        {
            return null;
        }

        var user = (await AuthenticationState).User;
        var allowed = await Authorization.AuthorizeAsync(user, PlatformAuthentication.PolicyName);
        var actor = user.FindFirst(IdentityClaims.Subject)?.Value;
        return allowed.Succeeded && !string.IsNullOrWhiteSpace(actor) ? actor : null;
    }

    private string TenantName(Guid tenantId) => _tenants.TryGetValue(tenantId, out var name) ? name : tenantId.ToString();

    private static string Code(CrOwnershipMethod method) => method == CrOwnershipMethod.Wathq ? "wathq" : "manual";

    private static string Name(string arabic, string english) =>
        System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? arabic : english;
}
