@*
    F-10 as narrowed (docs/05 row 22, vendor plan task 5, V-7, V-11): a related vendor's card for the tenant's staff, its
    documents that passed the virus check with their expiry (current and replaced files), what blocks it from submitting
    today, and Approve behind a confirmation dialog while it is pending. A company the tenant has no relationship with
    shows only "not found". Contracts officers and tenant admins only (VendorManager policy); the directory checks the role
    again in identity.members when Approve runs, since the circuit's claims date from when the page opened.
    W-33: before a company's first approval by any tenant the dialog carries the ownership check. It is loaded when the
    dialog opens (a Wathq lookup is paid per call, so never on page load): the CR number, the registering person from the
    identity provider, and the CR's owners and managers from Wathq when that is the platform's method, or why the officer
    checks by hand. The officer confirms with a box and a note; a company verified already (here or at another tenant,
    which is never told) is approved without it.
*@
@page "/admin/vendors/{CompanyId:guid}"
@attribute [Authorize(Policy = VendorPolicies.VendorManager)]
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.Components.QuickGrid
@using Platform.Modules.Vendors.Contracts
@using Platform.Shared.Results
@inject IVendorDirectory Directory
@inject ToastService Toasts
@inject TimeProvider Clock
@inject ILogger<VendorDetails> Logger
@inject IStringLocalizer<SharedResource> T

<PageTitle>@(_vendor is null ? T["Admin.Vendors.Title"] : Name(_vendor.NameAr, _vendor.NameEn))</PageTitle>

<p><a href="admin/vendors" class="underline underline-offset-4">@T["Admin.Vendors.Back"]</a></p>

@if (!_loaded)
{
    <p class="text-ink-muted" role="status">@T["Admin.Vendors.Loading"]</p>
}
else if (_vendor is not { } vendor)
{
    <p data-vendor-not-found role="status" class="max-w-prose">@T["Admin.Vendors.NotFound"]</p>
}
else
{
    <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-display">@Name(vendor.NameAr, vendor.NameEn)</h1>
        @if (vendor.Status == VendorRelationshipStatus.Pending)
        {
            <Button @ref="_approveButton" Variant="ButtonVariant.Primary" data-approve OnClick="OpenApprove">@T["Admin.Vendors.Approve"]</Button>
        }
    </div>

    <section data-vendor-card="@vendor.Id" aria-labelledby="card-heading" class="grid gap-3 rounded-card border border-line bg-surface p-4">
        <h2 id="card-heading" class="text-heading">@T["Admin.Vendors.Card.Heading"]</h2>
        <dl class="grid gap-x-6 gap-y-2 text-body sm:grid-cols-[auto_1fr]">
            <dt class="font-semibold">@T["Admin.Vendors.Column.Status"]</dt>
            <dd>
                @if (vendor.Status == VendorRelationshipStatus.Approved)
                {
                    <StatusBadge Tone="StatusTone.Success" data-vendor-status="@($"{vendor.Id}:approved")">@T["Admin.Vendors.Status.Approved"]</StatusBadge>
                }
                else
                {
                    <StatusBadge Tone="StatusTone.Warning" data-vendor-status="@($"{vendor.Id}:pending")">@T["Admin.Vendors.Status.Pending"]</StatusBadge>
                }
            </dd>
            <dt class="font-semibold">@T["Vendor.Field.NameAr"]</dt>
            <dd lang="ar" dir="rtl" class="text-start">@vendor.NameAr</dd>
            <dt class="font-semibold">@T["Vendor.Field.NameEn"]</dt>
            <dd lang="en" dir="ltr" class="text-start">@vendor.NameEn</dd>
            <dt class="font-semibold">@T["Vendor.Field.CrNumber"]</dt>
            <dd dir="ltr" class="text-start tabular-nums">@vendor.CrNumber</dd>
            <dt class="font-semibold">@T["Vendor.Field.VatNumber"]</dt>
            <dd dir="ltr" class="text-start tabular-nums">@vendor.VatNumber</dd>
            @if (!string.IsNullOrWhiteSpace(vendor.Address))
            {
                <dt class="font-semibold">@T["Vendor.Field.Address"]</dt>
                <dd>@vendor.Address</dd>
            }
            <dt class="font-semibold">@T["Vendor.Field.ContactName"]</dt>
            <dd>@vendor.ContactName</dd>
            @if (!string.IsNullOrWhiteSpace(vendor.ContactPhone))
            {
                <dt class="font-semibold">@T["Vendor.Field.ContactPhone"]</dt>
                <dd dir="ltr" class="text-start tabular-nums">@vendor.ContactPhone</dd>
            }
            <dt class="font-semibold">@T["Vendor.Field.ContactEmail"]</dt>
            <dd dir="ltr" class="text-start">@vendor.ContactEmail</dd>
            <dt class="font-semibold">@T["Admin.Vendors.Field.FirstSeen"]</dt>
            <dd>
                <time datetime="@vendor.FirstSeenAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@FormatDate(Riyadh(vendor.FirstSeenAt))</time>
            </dd>
        </dl>
    </section>

    <section aria-labelledby="documents-heading" class="grid gap-3">
        <h2 id="documents-heading" class="text-heading">@T["Admin.Vendors.Documents.Heading"]</h2>
        @if (vendor.BlockingDocuments.Count > 0)
        {
            <div role="note" class="grid max-w-prose gap-2 rounded-card border border-warning bg-warning/10 p-4 text-ink">
                <p class="font-semibold">@T["Admin.Vendors.Blocking.Heading"]</p>
                <ul class="grid list-disc gap-1 ps-5">
                    @foreach (var item in vendor.BlockingDocuments)
                    {
                        <li data-blocking="@($"{item.Type}:{(item.Reason == BlockingReason.Expired ? "expired" : "missing")}")">
                            @if (item.Reason == BlockingReason.Expired && item.ExpiredOn is { } expiredOn)
                            {
                                @T["Vendor.Blocking.Expired", Name(item.NameAr, item.NameEn), FormatDate(expiredOn)]
                            }
                            else
                            {
                                @T["Vendor.Blocking.Missing", Name(item.NameAr, item.NameEn)]
                            }
                        </li>
                    }
                </ul>
            </div>
        }
        <DataTable Items="vendor.Documents" Label="@T["Admin.Vendors.Documents.Table"]">
            <ChildContent>
                <TemplateColumn TGridItem="RelatedVendorDocument" Title="@T["Vendor.Documents.ColumnType"]">
                    <span class="font-semibold" data-document="@context.Id">@TypeName(context.Type)</span>
                </TemplateColumn>
                <TemplateColumn TGridItem="RelatedVendorDocument" Title="@T["Vendor.Documents.ColumnExpiry"]">
                    <time datetime="@context.ExpiresOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" class="whitespace-nowrap">@FormatDate(context.ExpiresOn)</time>
                </TemplateColumn>
                <TemplateColumn TGridItem="RelatedVendorDocument" Title="@T["Vendor.Documents.ColumnStatus"]">
                    @if (!context.IsCurrent)
                    {
                        <StatusBadge Tone="StatusTone.Neutral" data-document-status="@($"{context.Id}:history")">@T["Admin.Vendors.Document.History"]</StatusBadge>
                    }
                    else if (context.ExpiresOn < _today)
                    {
                        <StatusBadge Tone="StatusTone.Danger" data-document-status="@($"{context.Id}:expired")">@T["Admin.Vendors.Document.Expired"]</StatusBadge>
                    }
                    else
                    {
                        <StatusBadge Tone="StatusTone.Success" data-document-status="@($"{context.Id}:current")">@T["Admin.Vendors.Document.Current"]</StatusBadge>
                    }
                </TemplateColumn>
            </ChildContent>
            <EmptyContent>
                <EmptyState Title="@T["Admin.Vendors.Documents.Empty"]" HeadingLevel="3" />
            </EmptyContent>
        </DataTable>
    </section>

    <Dialog @bind-Open="_approveOpen" Busy="_busy" OnConfirm="ApproveAsync" ReturnFocus="_approveButton?.Element"
            Title="@T["Admin.Vendors.ApproveTitle", Name(vendor.NameAr, vendor.NameEn)]" ConfirmText="@T["Admin.Vendors.ApproveConfirm"]">
        @if (_check is null)
        {
            <p role="status" class="text-ink-muted" data-ownership-loading>@T["Admin.Vendors.Ownership.Loading"]</p>
        }
        else if (_check.Verified)
        {
            <p data-ownership-verified="@MethodCode(_check.VerifiedMethod)">@T["Admin.Vendors.Ownership.AlreadyVerified", MethodName(_check.VerifiedMethod)]</p>
        }
        else
        {
            <section data-ownership-check aria-labelledby="ownership-heading" class="grid gap-3 rounded-card border border-line p-3">
                <h3 id="ownership-heading" class="text-subheading">@T["Admin.Vendors.Ownership.Heading"]</h3>
                <p class="text-small text-ink-muted">@T["Admin.Vendors.Ownership.Intro"]</p>
                @if (_check.Disputed)
                {
                    <p role="note" data-ownership-disputed class="text-small text-danger">@T["Admin.Vendors.Ownership.Disputed"]</p>
                }
                @if (!_check.HasCertificate)
                {
                    <p role="note" data-ownership-no-certificate class="text-small text-warning">@T["Admin.Vendors.Ownership.NoCertificate"]</p>
                }
                <dl class="grid gap-x-4 gap-y-1 text-small sm:grid-cols-[auto_1fr]">
                    <dt class="font-semibold">@T["Vendor.Field.CrNumber"]</dt>
                    <dd dir="ltr" class="text-start tabular-nums">@_check.CrNumber</dd>
                    <dt class="font-semibold">@T["Admin.Vendors.Ownership.Registrant"]</dt>
                    <dd data-ownership-registrant>
                        @if (_check.Registrant is { Name: null, Email: null })
                        {
                            <span class="text-ink-muted">@T["Admin.Vendors.Ownership.RegistrantUnknown"]</span>
                        }
                        else if (_check.Registrant is { } registrant)
                        {
                            <span class="grid">
                                @if (registrant.Name is not null)
                                {
                                    <span data-registrant-name>@registrant.Name <span class="text-ink-muted">@T["Admin.Vendors.Ownership.SelfDeclared"]</span></span>
                                }
                                @if (registrant.Email is not null)
                                {
                                    <span data-registrant-email="@(registrant.EmailVerified ? "verified" : "unverified")">
                                        <bdi dir="ltr">@registrant.Email</bdi>
                                        <span class="text-ink-muted">@(registrant.EmailVerified ? T["Admin.Vendors.Ownership.EmailVerified"] : T["Admin.Vendors.Ownership.EmailUnverified"])</span>
                                    </span>
                                }
                            </span>
                        }
                    </dd>
                </dl>
                @if (_check.Lookup is { } lookup)
                {
                    <div data-ownership-lookup="@LookupCode(lookup.Outcome)" class="grid gap-2 text-small">
                        @if (lookup.Outcome == CrLookupOutcome.Found)
                        {
                            <p>@T["Admin.Vendors.Ownership.Wathq.Found"]</p>
                            <p class="font-semibold">@T["Admin.Vendors.Ownership.Wathq.Owners"]</p>
                            <ul class="grid list-disc gap-1 ps-5">
                                @foreach (var party in lookup.Owners)
                                {
                                    <li data-wathq-owner>@Party(party)</li>
                                }
                            </ul>
                            <p class="font-semibold">@T["Admin.Vendors.Ownership.Wathq.Managers"]</p>
                            @if (lookup.Managers.Count == 0)
                            {
                                <p class="text-ink-muted">@T["Admin.Vendors.Ownership.Wathq.NoManagers"]</p>
                            }
                            else
                            {
                                <ul class="grid list-disc gap-1 ps-5">
                                    @foreach (var party in lookup.Managers)
                                    {
                                        <li data-wathq-manager>@Party(party)</li>
                                    }
                                </ul>
                            }
                        }
                        else
                        {
                            <p>@T[$"Admin.Vendors.Ownership.Lookup.{lookup.Outcome}"]</p>
                        }
                    </div>
                }
                @* ADR-0013 residual risk: the name is self-declared and the certificate is public, so the officer asks for more. *@
                <p role="note" data-ownership-guidance class="text-small">@T["Admin.Vendors.Ownership.Guidance"]</p>
                <label class="flex min-h-11 cursor-pointer items-center gap-3 text-body">
                    <input type="checkbox" class="size-5 shrink-0 accent-action" data-ownership-confirm @bind="_confirmed" />
                    @T["Admin.Vendors.Ownership.Confirm"]
                </label>
                <Textarea Label="@T["Admin.Vendors.Ownership.Note"]" Help="@T["Admin.Vendors.Ownership.NoteHelp"]" Required="true" Rows="3"
                          @bind-Value="_note" Error="@_noteError" data-ownership-note maxlength="1000" />
            </section>
        }
        <p>@T["Admin.Vendors.ApproveBody"]</p>
        @if (_approveError is not null)
        {
            <p role="alert" class="text-small text-danger">@_approveError</p>
        }
    </Dialog>
}

<ToastRegion />

@code {
    private RelatedVendorDetails? _vendor;
    private bool _loaded;
    private DateOnly _today;
    private Button? _approveButton;
    private bool _approveOpen;
    private bool _busy;
    private string? _approveError;
    private OwnershipCheck? _check;
    private bool _confirmed;
    private string? _note;
    private string? _noteError;

    [Parameter] public Guid CompanyId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        // Riyadh is UTC+3 all year: the day documents are checked against, whatever the server's time zone.
        _today = DateOnly.FromDateTime(Riyadh(Clock.GetUtcNow()));
        _vendor = await Directory.GetRelatedAsync(CompanyId);
        _loaded = true;
    }

    private async Task OpenApprove()
    {
        _approveError = null;
        _noteError = null;
        _confirmed = false;
        _note = null;
        _check = null;
        _approveOpen = true;
        try
        {
            _check = await Directory.GetOwnershipCheckAsync(CompanyId);
            if (_check is null)
            {
                _approveError = T["Admin.Vendors.NotFound"];
            }
        }
        catch (Exception ex)
        {
            VendorAdminLog.OwnershipCheckFailed(Logger, ex.GetType().Name);
            _approveError = T["Admin.Vendors.Error.Generic"];
        }
    }

    private async Task ApproveAsync()
    {
        if (_vendor is not { } vendor)
        {
            return;
        }

        _approveError = null;
        _busy = true;
        try
        {
            var user = AuthenticationState is null ? null : (await AuthenticationState).User;
            var actor = user?.FindFirst(IdentityClaims.Subject)?.Value;
            if (string.IsNullOrWhiteSpace(actor))
            {
                _approveError = T["Admin.Vendors.Error.NotAllowed"];
                return;
            }

            if (_check is null)
            {
                _approveError ??= T["Admin.Vendors.Error.Generic"];
                return;
            }

            _noteError = null;
            Result<VendorRelationshipStatus> result;
            if (_check.Verified)
            {
                result = await Directory.ApproveAsync(vendor.Id, actor);
            }
            else
            {
                if (!_confirmed)
                {
                    _approveError = T["Admin.Vendors.Ownership.Error.NotConfirmed"];
                    return;
                }

                var outcome = _check.Lookup?.Outcome ?? CrLookupOutcome.Manual;
                result = await Directory.ApproveAsync(
                    vendor.Id, actor, new OwnershipConfirmation(_note, BasedOnWathq: outcome == CrLookupOutcome.Found, outcome));
            }

            if (!result.IsSuccess && result.Error.Code == CrOwnershipErrors.NoteRequired)
            {
                _noteError = T["Admin.Vendors.Ownership.Error.Note"];
                return;
            }

            if (!result.IsSuccess && result.Error.Code != VendorDirectoryErrors.AlreadyApproved)
            {
                _approveError = result.Error.Code switch
                {
                    VendorDirectoryErrors.NotAllowed => T["Admin.Vendors.Error.NotAllowed"],
                    VendorDirectoryErrors.NotFound => T["Admin.Vendors.NotFound"],
                    CrOwnershipErrors.Unverified => T["Admin.Vendors.Ownership.Error.Unverified"],
                    CrOwnershipErrors.NoCertificate => T["Admin.Vendors.Ownership.NoCertificate"],
                    CrOwnershipErrors.Disputed => T["Admin.Vendors.Ownership.Disputed"],
                    CrOwnershipErrors.WathqNotSelected => T["Admin.Vendors.Ownership.Error.WathqNotSelected"],
                    _ => T["Admin.Vendors.Error.Generic"],
                };
                return;
            }

            // Approved now, or by someone else since the page opened: either way the card shows it as approved.
            Toasts.Show(result.IsSuccess ? T["Admin.Vendors.Approved", Name(vendor.NameAr, vendor.NameEn)] : T["Admin.Vendors.Error.AlreadyApproved"]);
            _approveOpen = false;
            _vendor = await Directory.GetRelatedAsync(vendor.Id);
        }
        catch (Exception ex)
        {
            VendorAdminLog.ApproveFailed(Logger, ex.GetType().Name);
            _approveError = T["Admin.Vendors.Error.Generic"];
        }
        finally
        {
            _busy = false;
        }
    }

    private static string LookupCode(CrLookupOutcome outcome) => outcome switch
    {
        CrLookupOutcome.Manual => "manual",
        CrLookupOutcome.Found => "found",
        CrLookupOutcome.NotConfigured => "not-configured",
        CrLookupOutcome.Unavailable => "unavailable",
        _ => "not-found",
    };

    private static string MethodCode(OwnershipVerificationMethod? method) => method?.ToString().ToLowerInvariant() ?? string.Empty;

    private string MethodName(OwnershipVerificationMethod? method) =>
        T[$"Admin.Vendors.Ownership.Method.{method ?? OwnershipVerificationMethod.Manual}"];

    private string Party(CrParty party)
    {
        var details = new[] { party.Type }.Concat(party.Positions).Where(d => !string.IsNullOrWhiteSpace(d)).Distinct(StringComparer.Ordinal).ToList();
        return details.Count == 0 ? party.Name : T["Admin.Vendors.Ownership.Wathq.Party", party.Name, string.Join(T["Admin.Vendors.Ownership.Wathq.Separator"].Value, details)];
    }

    private static string TypeName(string code) =>
        VendorDocumentTypes.Find(code) is { } type ? Name(type.NameAr, type.NameEn) : code;

    private static string Name(string arabic, string english) =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? arabic : english;

    private static DateTime Riyadh(DateTimeOffset at) => at.ToOffset(TimeSpan.FromHours(3)).DateTime;

    private string FormatDate(DateTime at) => FormatDate(DateOnly.FromDateTime(at));

    // ar-SA defaults to the Umm al-Qura calendar; the product shows Gregorian dates in both languages.
    private string FormatDate(DateOnly date)
    {
        var culture = CultureInfo.CurrentCulture;
        if (culture.Calendar is not GregorianCalendar)
        {
            culture = (CultureInfo)culture.Clone();
            culture.DateTimeFormat.Calendar = new GregorianCalendar();
        }

        return date.ToString(T["Vendor.Documents.DateFormat"].Value, culture);
    }
}
